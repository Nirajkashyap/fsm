# AUTO-GENERATED by fsm-compiler-ts. Do not edit directly.
"""Wire protocol for the gateway <-> per-language worker sidecar connection.

Python port of the gateway's sidecar/protocol.ts. The wire shapes here must
match that file byte-for-byte (same JSON key names, same framing) since a
Python worker process and the TypeScript-hosted gateway talk this protocol to
each other over the same Unix socket.

Framing: 4-byte big-endian length prefix + UTF-8 JSON payload — chosen over
newline/stdio framing so a worker's own prints can never corrupt the RPC
channel.
"""

from __future__ import annotations

import json
import socket
import struct
import time
import uuid
from typing import Any, Dict, Optional


def now_unix_ms() -> int:
    return int(time.time() * 1000)


def make_envelope(
    msg_type: str,
    source: str,
    target: str,
    body: Dict[str, Any],
    trace_id: Optional[str] = None,
) -> Dict[str, Any]:
    return {
        "v": "1.0",
        "id": str(uuid.uuid4()),
        "type": msg_type,
        "ts_unix_ms": now_unix_ms(),
        "source": source,
        "target": target,
        "trace_id": trace_id,
        "body": body,
    }


def actor_key(
    parent_fsm_name: str,
    parent_fsm_version: str,
    async_operation_type: str,
    async_operation_name: str,
    async_operation_version: str,
    async_operation_language: str,
) -> str:
    return (
        f"{parent_fsm_name}@{parent_fsm_version}@{async_operation_type}@{async_operation_name}"
        f"@{async_operation_version}@{async_operation_language}"
    )


def write_frame(sock: socket.socket, envelope: Dict[str, Any]) -> None:
    payload = json.dumps(envelope).encode("utf-8")
    header = struct.pack(">I", len(payload))
    sock.sendall(header)
    sock.sendall(payload)


def read_frame(sock: socket.socket) -> Optional[Dict[str, Any]]:
    header = _recv_exact(sock, 4)
    if header is None:
        return None

    (length,) = struct.unpack(">I", header)
    payload = _recv_exact(sock, length)
    if payload is None:
        return None

    return json.loads(payload.decode("utf-8"))


def _recv_exact(sock: socket.socket, size: int) -> Optional[bytes]:
    data = b""
    while len(data) < size:
        chunk = sock.recv(size - len(data))
        if chunk == b"":
            return None
        data += chunk
    return data
