// AUTO-GENERATED by fsm-compiler-ts. Do not edit directly.
//! Rust worker SDK: connects to the gateway's sidecar Unix socket, registers
//! a compiled-in actor registry, and serves invoke requests.
//!
//! Unlike worker-sdk/typescript and worker-sdk/python, this has no
//! folder-scanning/dynamic-import step — Rust has no runtime mechanism to
//! load a function out of a `.rs` source file the way `import()` (TS) or
//! `importlib` (Python) can. Instead, `ActorWorker` takes an explicit
//! `Vec<ActorRegistration>` built at compile time by the binary that uses
//! this SDK (see main.rs) — the actor functions are linked into the binary
//! directly, and "verification" happens at compile time (it wouldn't build
//! if the function didn't exist or had the wrong signature) rather than at
//! worker startup.
//!
//! Same wire protocol (protocol.rs, ported from the gateway's
//! sidecar/protocol.ts), same `actor_key()` identity, same register ->
//! heartbeat -> serve lifecycle as the TypeScript/Python versions. Plain
//! blocking `UnixStream` + a heartbeat thread (std only, no async runtime) —
//! the natural Rust shape for the same protocol, matching worker-sdk/python's
//! choice for the same reason.

use crate::protocol::{actor_key, make_envelope, read_frame, write_frame, RegisteredActor};
use serde_json::{json, Value};
use std::collections::HashMap;
use std::io;
use std::os::unix::net::UnixStream;
use std::panic::{catch_unwind, AssertUnwindSafe};
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::Arc;
use std::thread;
use std::time::Duration;

/// An actor's compiled-in implementation. Panics are caught by the SDK and
/// reported to the gateway as an `INTERNAL` invoke error rather than
/// crashing the worker process — the Rust equivalent of catching a thrown
/// exception in the TypeScript/Python versions.
pub type ActorHandler = Box<dyn Fn(Value) -> Value + Send + Sync>;

pub struct ActorRegistration {
    pub meta: RegisteredActor,
    pub handler: ActorHandler,
}

pub struct ActorWorkerOptions {
    pub worker_id: String,
    pub gateway_socket_path: String,
    pub heartbeat_ms: u64,
}

pub struct ActorWorker {
    options: ActorWorkerOptions,
    handlers: HashMap<String, ActorHandler>,
    registered: Vec<RegisteredActor>,
    stopped: Arc<AtomicBool>,
}

impl ActorWorker {
    pub fn new(options: ActorWorkerOptions, registrations: Vec<ActorRegistration>) -> Self {
        let mut handlers = HashMap::new();
        let mut registered = Vec::with_capacity(registrations.len());
        for reg in registrations {
            let key = actor_key(
                &reg.meta.parent_fsm_name,
                &reg.meta.parent_fsm_version,
                &reg.meta.async_operation_type,
                &reg.meta.async_operation_name,
                &reg.meta.async_operation_version,
                &reg.meta.async_operation_language,
            );
            handlers.insert(key, reg.handler);
            registered.push(reg.meta);
        }
        Self {
            options,
            handlers,
            registered,
            stopped: Arc::new(AtomicBool::new(false)),
        }
    }

    pub fn run(&self) -> io::Result<()> {
        if self.registered.is_empty() {
            return Err(io::Error::new(
                io::ErrorKind::InvalidInput,
                "no actors to register, refusing to start worker",
            ));
        }

        let mut stream = UnixStream::connect(&self.options.gateway_socket_path)?;

        let register_body = json!({
            "worker_id": self.options.worker_id,
            "language": "rust",
            "protocol_version": "1.0",
            "actors": self.registered,
        });
        write_frame(
            &mut stream,
            &make_envelope(
                "register",
                &format!("worker:{}", self.options.worker_id),
                "gateway",
                register_body,
            ),
        )?;

        let ack = read_frame(&mut stream)?.ok_or_else(|| {
            io::Error::new(
                io::ErrorKind::UnexpectedEof,
                "gateway closed connection during register",
            )
        })?;
        if ack.msg_type != "register_ack" {
            return Err(io::Error::new(
                io::ErrorKind::InvalidData,
                format!("expected register_ack but got {}", ack.msg_type),
            ));
        }
        let accepted = ack
            .body
            .get("accepted")
            .and_then(Value::as_bool)
            .unwrap_or(false);
        if !accepted {
            return Err(io::Error::new(
                io::ErrorKind::InvalidData,
                "gateway rejected registration",
            ));
        }

        println!(
            "Worker {} registered {} actor(s) with the gateway",
            self.options.worker_id,
            self.registered.len()
        );

        let mut heartbeat_stream = stream.try_clone()?;
        let stopped = self.stopped.clone();
        let worker_id = self.options.worker_id.clone();
        let heartbeat_ms = self.options.heartbeat_ms;
        let heartbeat_handle = thread::spawn(move || {
            while !stopped.load(Ordering::SeqCst) {
                thread::sleep(Duration::from_millis(heartbeat_ms));
                if stopped.load(Ordering::SeqCst) {
                    break;
                }
                let envelope = make_envelope(
                    "heartbeat",
                    &format!("worker:{}", worker_id),
                    "gateway",
                    json!({ "worker_id": worker_id }),
                );
                if write_frame(&mut heartbeat_stream, &envelope).is_err() {
                    stopped.store(true, Ordering::SeqCst);
                    break;
                }
            }
        });

        let serve_result = self.serve_loop(&mut stream);

        self.stopped.store(true, Ordering::SeqCst);
        let _ = heartbeat_handle.join();

        serve_result
    }

    pub fn stop(&self) {
        self.stopped.store(true, Ordering::SeqCst);
    }

    fn serve_loop(&self, stream: &mut UnixStream) -> io::Result<()> {
        while !self.stopped.load(Ordering::SeqCst) {
            let envelope = match read_frame(stream)? {
                Some(e) => e,
                None => break,
            };

            match envelope.msg_type.as_str() {
                "cancel" => continue,
                "unregister" => break,
                "invoke" => self.handle_invoke(stream, envelope.body)?,
                _ => continue,
            }
        }
        Ok(())
    }

    fn handle_invoke(&self, stream: &mut UnixStream, body: Value) -> io::Result<()> {
        let invoke_id = body
            .get("invoke_id")
            .and_then(Value::as_str)
            .unwrap_or("")
            .to_string();
        let key = actor_key(
            body.get("parent_fsm_name")
                .and_then(Value::as_str)
                .unwrap_or(""),
            body.get("parent_fsm_version")
                .and_then(Value::as_str)
                .unwrap_or(""),
            body.get("async_operation_type").and_then(Value::as_str).unwrap_or(""),
            body.get("async_operation_name").and_then(Value::as_str).unwrap_or(""),
            body.get("async_operation_version")
                .and_then(Value::as_str)
                .unwrap_or(""),
            body.get("async_operation_language")
                .and_then(Value::as_str)
                .unwrap_or(""),
        );

        let handler = match self.handlers.get(&key) {
            Some(h) => h,
            None => {
                return self.send_error(
                    stream,
                    &invoke_id,
                    "NOT_FOUND",
                    &format!("actor not found: {}", key),
                )
            }
        };

        let input = body.get("input").cloned().unwrap_or(Value::Null);
        match catch_unwind(AssertUnwindSafe(|| handler(input))) {
            Ok(output) => {
                let result_body = json!({ "invoke_id": invoke_id, "output": output });
                write_frame(
                    stream,
                    &make_envelope(
                        "invoke_result",
                        &format!("worker:{}", self.options.worker_id),
                        "gateway",
                        result_body,
                    ),
                )
            }
            Err(panic_payload) => {
                let message = panic_message(&panic_payload);
                self.send_error(stream, &invoke_id, "INTERNAL", &message)
            }
        }
    }

    fn send_error(
        &self,
        stream: &mut UnixStream,
        invoke_id: &str,
        code: &str,
        message: &str,
    ) -> io::Result<()> {
        let error_body = json!({
            "invoke_id": invoke_id,
            "error": { "code": code, "message": message, "retriable": false },
        });
        write_frame(
            stream,
            &make_envelope(
                "invoke_error",
                &format!("worker:{}", self.options.worker_id),
                "gateway",
                error_body,
            ),
        )
    }
}

fn panic_message(payload: &Box<dyn std::any::Any + Send>) -> String {
    if let Some(s) = payload.downcast_ref::<&str>() {
        s.to_string()
    } else if let Some(s) = payload.downcast_ref::<String>() {
        s.clone()
    } else {
        "actor panicked".to_string()
    }
}
